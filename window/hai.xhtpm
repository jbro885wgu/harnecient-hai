<!-- hai.xhtpm - hai-cli window (W1): the hai chat transcript and state, plus a typed composer (cli_io) that runs bin/hai_send. The module is the compiled
     hai_manager (publishes state/ui.txt from the chat ledger through the engine). Built from the
     _template-hq shape: sidebar + panel (chrome and taskbar entry), database-window (persistent). -->
<window label="hai-cli" class="hai database-window" vars="state/ui.txt">
  <module id="manager" src="bin/hai_manager"/>
  <page name="main">
    <sidebar id="sidebar" class="sidebar">
      <text label="Agents" class="block-title"/>
      <scrolllist class="from-top">
        <repeat count="${agents_count}" bind="agent">
          <item id="a${agent.#}" class="${agent.cls}" label="${agent.label}"
                action="'${PKG}/bin/hai_session' 'AGENT ${agent.name}'"/>
        </repeat>
      </scrolllist>
      <text label="Sessions" class="block-title"/>
      <item id="new" class="data-item" label="+ New Session" action="'${PKG}/bin/hai_session' 'NEW'"/>
      <scrolllist class="from-top">
        <repeat count="${sessions_count}" bind="session">
          <item id="s${session.#}" class="${session.cls}" label="${session.label}"
                action="'${PKG}/bin/hai_session' 'SWITCH ${session.name}'"
                backspace_action="'${PKG}/bin/hai_session' 'DELETE ${session.name}'"
                confirm="Delete session ${session.label}?"/>
        </repeat>
      </scrolllist>
      <text label="${agent} ${stamp}" class="quiet"/>
    </sidebar>
    <panel id="detail" class="settings-block">
      <text label="Type a line + Enter to chat. Teach: /teach w = meaning  /alias w = concept  /say w = text  /mark w  /forget w  /pack lyfedesk  /grade 0..4.  Agents: /agent new <id> [curious|terse|scholar]  /agent <id>" class="quiet"/>
      <scrolllist>
          <repeat count="${rows_count}" bind="row">
            <item id="row${row.#}" class="data-item ${row.cls}" label="${row.text}"/>
          </repeat>
          <text label="(no turns yet: type below)" class="quiet" show="${no_rows}"/>
        </scrolllist>
        <cli_io id="composer" target_id="composer" rows="2" class="composer-text" label="&gt; " action="'${PKG}/bin/hai_send'"/>
    </panel>
  </page>
</window>

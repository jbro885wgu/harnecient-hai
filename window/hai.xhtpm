<!-- hai.xhtpm - W0 window: the hai chat transcript and state, read-only. The module is the compiled
     hai_manager (publishes state/ui.txt from the chat ledger through the engine). Built from the
     _template-hq shape: sidebar + panel (chrome and taskbar entry), database-window (persistent). -->
<window label="hai" class="hai database-window" vars="state/ui.txt">
  <module id="manager" src="bin/hai_manager"/>
  <page name="main">
    <sidebar id="sidebar" class="sidebar">
      <text label="hai ${stamp}" class="quiet"/>
      <text label="${state}" class="block-title"/>
      <text label="turns = ${turns}" class="quiet"/>
      <scrolllist>
        <repeat count="${rows_count}" bind="row">
          <item id="row${row.#}" class="data-item" label="${row.text}"/>
        </repeat>
        <text label="(no turns yet: type in the CLI, the window follows the ledger)" class="quiet" show="${no_rows}"/>
      </scrolllist>
    </sidebar>
    <panel id="detail" class="settings-block">
      <text label="hai window, W0 (read-only)" class="block-title"/>
      <text label="Each row is one turn from the chat ledger: what was typed, and the reply id." class="quiet"/>
      <text label="Typing in the window comes next (W1, needs a renderer change: approval first)." class="quiet"/>
    </panel>
  </page>
</window>

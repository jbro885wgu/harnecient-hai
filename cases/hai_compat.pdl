# hai_compat (2026-11-24): the C/JS DIFFERENTIAL case. A deterministic hostile script (ops/hai_fuzz.c, 3000 rows per seed) is run by the C op and by docs/world.js under the SAME rules file; the ledgers, the end state and the canvas frames of three pages must be BYTE-IDENTICAL. Two worlds (the house rules file and a small different one) prove the numbers are data on both sides. Every refusal reason must appear, so the fuzz cannot silently stop reaching them. Needs node, gcc, cmp. DEBT: absolute repo paths.
RESULTS | ../results/hai_compat.txt
ENV | LC_ALL | C

CASE    | default
SCRATCH |
ENV | HAI_RULES | /home/no/Desktop/github/work/#.hai/harnecient-hai/docs/world.rules.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/hai_world | /home/no/Desktop/github/work/#.hai/harnecient-hai/ops/hai_world.c
EXPECT_EXIT | 0 | c-op-builds-without-warnings
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/hai_fuzz | /home/no/Desktop/github/work/#.hai/harnecient-hai/ops/hai_fuzz.c
EXPECT_EXIT | 0 | fuzz-generator-builds-without-warnings
RUN | $T/hai_fuzz | 1 | 3000 | 16 | 10 | $T/default1.script
EXPECT_EXIT | 0 | default1-script-generated
RUN | $T/hai_world | run | $T/default1.c.l | $T/default1.script | $T/default1.c.s

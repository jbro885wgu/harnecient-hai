# the printf rounding rule: C rounds an exact tie to even (0.125 -> 0.12), JavaScript toFixed rounds it up (0.13). engine.js fmt() follows C. Checked against the system printf.
CASE    | rounding
SCRATCH |
RUN | /usr/bin/printf | %.2f | 0.125
EXPECT_EXIT | 0 | tie-0.125-printf-runs
RUN | node | -e | console.log(require('/home/no/Desktop/github/work/#.hai/harnecient-hai/docs/engine.js').fmt(0.125,2))
EXPECT_OUT_IS | 0.12 | tie-0.125-js-matches-printf
RUN | /usr/bin/printf | %.2f | 0.125
EXPECT_OUT_IS | 0.12 | tie-0.125-printf-says-0.12
RUN | /usr/bin/printf | %.2f | 0.375
EXPECT_EXIT | 0 | tie-0.375-printf-runs
RUN | node | -e | console.log(require('/home/no/Desktop/github/work/#.hai/harnecient-hai/docs/engine.js').fmt(0.375,2))
EXPECT_OUT_IS | 0.38 | tie-0.375-js-matches-printf
RUN | /usr/bin/printf | %.2f | 0.375
EXPECT_OUT_IS | 0.38 | tie-0.375-printf-says-0.38
RUN | /usr/bin/printf | %.2f | 0.625
EXPECT_EXIT | 0 | tie-0.625-printf-runs
RUN | node | -e | console.log(require('/home/no/Desktop/github/work/#.hai/harnecient-hai/docs/engine.js').fmt(0.625,2))
EXPECT_OUT_IS | 0.62 | tie-0.625-js-matches-printf
RUN | /usr/bin/printf | %.2f | 0.625
EXPECT_OUT_IS | 0.62 | tie-0.625-printf-says-0.62
RUN | /usr/bin/printf | %.2f | 0.875
EXPECT_EXIT | 0 | tie-0.875-printf-runs
RUN | node | -e | console.log(require('/home/no/Desktop/github/work/#.hai/harnecient-hai/docs/engine.js').fmt(0.875,2))
EXPECT_OUT_IS | 0.88 | tie-0.875-js-matches-printf
RUN | /usr/bin/printf | %.2f | 0.875
EXPECT_OUT_IS | 0.88 | tie-0.875-printf-says-0.88
RUN | /usr/bin/printf | %.4f | 0.03125
EXPECT_EXIT | 0 | tie-0.03125-printf-runs
RUN | node | -e | console.log(require('/home/no/Desktop/github/work/#.hai/harnecient-hai/docs/engine.js').fmt(0.03125,4))
EXPECT_OUT_IS | 0.0312 | tie-0.03125-js-matches-printf

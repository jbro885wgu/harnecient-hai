# hai_web_parity (2026-11-23): the C engine (ops/hai_chat) and the JS engine (docs/engine.js, the web demo) run the SAME scripted conversation and must say the SAME
# thing, line for line and exit code for exit code. The expected text was taken from the C tool and is written here as a literal, so BOTH engines are checked against it:
# a change in either one turns this case red. The conversation reaches: greeting, an unknown word that is asked about, the answer stored, a taught word recalled, an alias,
# a mark, a say, skip, the name flow, bye, a starter pack, forget, bad input for every lever, grades (good, repeat, out of range). Then the dumps: why, bank, stats, calib, state.
# Needs node (the JS engine is run from its command line). Timestamps are not compared (they differ by the second); output text and exit codes are.
RESULTS | ../results/hai_web_parity.txt
ENV | LC_ALL | C
ENV | HAI_NOW | 1700000000

CASE    | parity
SCRATCH |
RUN | cp | -r | /home/no/Desktop/github/work/#.hai/harnecient-hai/chat/data | $T/d
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -I | /home/no/Desktop/github/work/#.hai/harnecient-hai/ops | -o | $T/hai_chat | /home/no/Desktop/github/work/#.hai/harnecient-hai/ops/hai_chat.c | /home/no/Desktop/github/work/#.hai/harnecient-hai/ops/hai_chat_core.c
EXPECT_EXIT | 0 | the-c-engine-builds-from-source
# step 1: turn hey , how are u ?
RUN | $T/hai_chat | turn | $T/d | $T/c.led | hey , how are u ?
EXPECT_EXIT | 0 | s01-turn-hey-how-are-u-c-exit
EXPECT_OUT_IS | Hi. I can chat with fixed replies for now. Type help. (confidence 21%) | s01-turn-hey-how-are-u-c-text
RUN | node | /home/no/Desktop/github/work/#.hai/harnecient-hai/docs/engine.js | turn | $T/d | $T/j.led | hey , how are u ?
EXPECT_EXIT | 0 | s01-turn-hey-how-are-u-js-exit
